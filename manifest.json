{
    "manifest_version": 3,
    "name": "ELOUP.GG — разбор каток FACEIT",
    "version": "0.2.2",
    "description": "Кнопка «Разобрать на ELOUP» на странице матча FACEIT: демка уедет на разбор сама — статистика, счёт и 2D-реплей.",
    "permissions": ["storage"],
    "host_permissions": [
        "https://www.faceit.com/*",
        "https://api.faceit.com/*",
        "https://*.faceit-cdn.net/*",
        "https://*.backblazeb2.com/*",
        "https://eloup.gg/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "ELOUP.GG",
        "default_icon": {
            "16": "icons/icon-16.png",
            "48": "icons/icon-48.png",
            "128": "icons/icon-128.png"
        }
    },
    "content_scripts": [
        {
            "matches": ["https://www.faceit.com/*"],
            "js": ["content.js"],
            "run_at": "document_idle"
        }
    ],
    "icons": {
        "16": "icons/icon-16.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    }
}
